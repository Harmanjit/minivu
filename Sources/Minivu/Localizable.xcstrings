        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਕੋਈ ਵੀ ਨਿਸ਼ਾਨ ਨਾ ਲੱਗਾ ਹੋਵੇ ਤਾਂ ਹਰ ਕਿਸਮ ਦਿਸਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
