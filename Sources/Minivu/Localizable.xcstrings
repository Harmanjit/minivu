            "value" : "ブラシサイズ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "브러시 크기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penseelgrootte"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਬੁਰਸ਼ ਦਾ ਆਕਾਰ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozmiar pędzla"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tamanho do pincel"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "தூரிகை அளவு"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "画笔大小"
          }
        }
      }
    },
    "Brush size is in pixels of the full image; zoom to 100% to judge it. Fewer levels paint flatter patches." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ব্রাশের আকার পূর্ণ ছবির পিক্সেলে; বিচার করতে 100%-এ জুম করুন। কম লেভেল আরও সমতল প্যাচ আঁকে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Pinselgröße wird in Pixeln des vollständigen Bilds angegeben; zoome auf 100 %, um sie zu beurteilen. Weniger Stufen malen flachere Flächen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El tamaño del pincel está en píxeles de la imagen completa; amplía al 100 % para valorarlo. Menos niveles pintan zonas más planas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La taille du pinceau est exprimée en pixels de l’image entière ; zoomez à 100 % pour l’évaluer. Moins de niveaux donnent des aplats plus marqués."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "બ્રશનું કદ સંપૂર્ણ ઇમેજના પિક્સેલમાં છે; તેનો અંદાજ લગાવવા 100% પર ઝૂમ કરો. ઓછાં લેવલ વધુ સપાટ પૅચ દોરે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ब्रश का आकार पूरी इमेज के पिक्सेल में है; इसे परखने के लिए 100% पर ज़ूम करें। कम लेवल से सपाट पैच पेंट होते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La dimensione del pennello è in pixel dell’immagine intera; ingrandisci al 100% per valutarla. Meno livelli producono zone di colore più piatte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ブラシサイズはフルサイズのイメージのピクセル単位です。100% に拡大して確認してください。レベルを少なくすると、よりフラットな色面で描かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "브러시 크기는 전체 이미지의 픽셀 단위입니다. 정확히 판단하려면 100%로 확대하십시오. 레벨이 적을수록 더 평평한 패치로 칠해집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penseelgrootte is in pixels van de volledige afbeelding; zoom in tot 100% om dit te beoordelen. Minder niveaus schilderen vlakkere vlekken."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਬੁਰਸ਼ ਦਾ ਆਕਾਰ ਪੂਰੇ ਚਿੱਤਰ ਦੇ ਪਿਕਸਲਾਂ ਵਿੱਚ ਹੈ; ਇਸਨੂੰ ਪਰਖਣ ਲਈ 100% ਤੱਕ ਜ਼ੂਮ ਕਰੋ। ਘੱਟ ਲੈਵਲ ਵਧੇਰੇ ਸਪਾਟ ਧੱਬੇ ਪੇਂਟ ਕਰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rozmiar pędzla jest podawany w pikselach pełnego obrazu; ustaw powiększenie na 100%, aby go ocenić. Mniej poziomów maluje bardziej płaskie plamy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O tamanho do pincel é em pixels da imagem inteira; amplie para 100% para avaliá-lo. Menos níveis pintam manchas mais planas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "தூரிகை அளவு முழுப் படத்தின் பிக்சல்களில் உள்ளது; அதை மதிப்பிட 100%-க்குப் பெரிதாக்குங்கள். குறைவான நிலைகள் தட்டையான திட்டுகளை வரையும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "画笔大小以完整图像的像素为单位；缩放到 100% 以便判断。色阶越少，绘制的色块越平。"
          }
        }
      }
    },
