    "Some files couldn’t be labelled; the others were. Their Finder tags couldn’t be read or written:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Einige Dateien konnten nicht mit einem Farbetikett versehen werden, die anderen schon. Ihre Finder-Tags konnten nicht gelesen oder geschrieben werden:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se han podido etiquetar algunos archivos; los demás sí. No se han podido leer ni escribir sus etiquetas de Finder:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Certains fichiers n’ont pas pu recevoir d’étiquette ; les autres l’ont reçue. Leurs tags du Finder n’ont pas pu être lus ou écrits :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è stato possibile etichettare alcuni file; gli altri sono stati etichettati. Impossibile leggere o scrivere i loro tag del Finder:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "一部のファイルにラベルを付けられませんでした（ほかのファイルには付けられました）。次のファイルのFinderタグを読み書きできませんでした："
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "일부 파일에는 레이블을 지정할 수 없었고 나머지 파일에는 지정했습니다. 해당 파일의 Finder 태그를 읽거나 쓸 수 없습니다:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sommige bestanden konden geen label krijgen; de andere wel. Hun Finder-tags konden niet worden gelezen of geschreven:"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można było nadać etykiety niektórym plikom; pozostałym nadano. Nie można odczytać ani zapisać ich tagów Findera:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não foi possível etiquetar alguns arquivos; os demais foram etiquetados. Não foi possível ler ou gravar as etiquetas do Finder deles:"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "部分文件无法添加颜色标签，其他文件已添加。无法读取或写入它们的“访达”标签："
          }
        }
      }
    },
    "Some files couldn’t be renamed; the others were." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Einige Dateien konnten nicht umbenannt werden, die anderen schon."
          }
        },
