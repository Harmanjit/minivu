    "None ticked shows every type." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কোনোটিতে টিক না দিলে প্রতিটি ধরন দেখায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ist nichts markiert, werden alle Typen angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si no se marca ninguno, se muestran todos los tipos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Si aucun n’est coché, tous les types sont affichés."
