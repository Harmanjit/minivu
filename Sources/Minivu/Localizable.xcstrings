    "%@ Pictures are written in sRGB; HDR photos are shown as on a standard display." : {
      "comment" : "%@ is a whole sentence about the chosen format; this second sentence follows it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Bilder werden in sRGB geschrieben; HDR-Fotos werden wie auf einem Standarddisplay dargestellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Las imágenes se escriben en sRGB; las fotos HDR se muestran como en una pantalla estándar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Les images sont écrites en sRGB ; les photos HDR sont affichées comme sur un écran standard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Le immagini vengono scritte in sRGB; le foto HDR vengono visualizzate come su un monitor standard."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ピクチャはsRGBで書き出され、HDR写真は標準ディスプレイでの表示と同じになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 사진은 sRGB로 기록되며, HDR 사진은 표준 디스플레이에서처럼 표시됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Afbeeldingen worden in sRGB geschreven; HDR-foto’s worden getoond zoals op een standaardscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Obrazy są zapisywane w sRGB; zdjęcia HDR wyglądają jak na standardowym ekranie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ As imagens são gravadas em sRGB; as fotos HDR aparecem como em uma tela padrão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 图片以 sRGB 写入；HDR 照片按标准显示器上的效果显示。"
          }
        }
      }
    },
