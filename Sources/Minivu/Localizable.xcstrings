    "HDR photos keep their highlights, written with a gain map. Off, they are tone mapped to SDR." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR ফটো তাদের হাইলাইট রাখে, গেইন ম্যাপসহ লেখা হয়। বন্ধ থাকলে সেগুলো SDR-এ টোন ম্যাপ করা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR-Fotos behalten ihre Lichter, mit einer Gain-Map geschrieben. Ist dies deaktiviert, werden sie per Tone-Mapping in SDR umgewandelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las fotos HDR conservan sus altas luces, escritas con un mapa de ganancia. Si se desactiva, se convierten a SDR mediante mapeo de tonos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les photos HDR conservent leurs hautes lumières, écrites avec une carte de gain. Si l’option est désactivée, leur tonalité est adaptée au SDR."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR ફોટો ગેઇન મૅપ સાથે લખાઈને પોતાની હાઇલાઇટ જાળવે છે. બંધ હોય ત્યારે, તેમને SDRમાં ટોન મૅપ કરવામાં આવે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR फ़ोटो अपने हाइलाइट्स बनाए रखती हैं, गेन मैप के साथ लिखी जाती हैं। बंद होने पर उन्हें SDR में टोन मैप किया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le foto HDR mantengono le alte luci, scritte con una mappa di guadagno. Se disattivato, vengono convertite in SDR con tone mapping."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR写真のハイライトを保持し、ゲインマップ付きで書き出します。オフにすると、トーンマッピングされてSDRになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR 사진은 게인 맵과 함께 기록되어 하이라이트가 유지됩니다. 끄면 SDR로 톤 매핑됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR-foto’s behouden hun hoge lichten, geschreven met een gain map. Uit worden ze via toonmapping naar SDR omgezet."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR ਫ਼ੋਟੋਆਂ ਆਪਣੀਆਂ ਹਾਈਲਾਈਟਾਂ ਰੱਖਦੀਆਂ ਹਨ, ਗੇਨ ਮੈਪ ਨਾਲ ਲਿਖੀਆਂ। ਬੰਦ ਹੋਣ ’ਤੇ, ਉਹਨਾਂ ਨੂੰ SDR ਵਿੱਚ ਟੋਨ ਮੈਪ ਕੀਤਾ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zdjęcia HDR zachowują jasne partie, zapisane z mapą wzmocnienia. Gdy opcja jest wyłączona, są mapowane tonalnie do SDR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As fotos HDR mantêm os realces, gravadas com um mapa de ganho. Se desativado, elas passam por mapeamento de tons para SDR."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR புகைப்படங்கள் கெயின் மேப்புடன் எழுதப்பட்டு, அவற்றின் ஹைலைட்களை வைத்திருக்கும். முடக்கினால், அவை SDR-க்கு டோன் மேப் செய்யப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR 照片保留高光，并以增益图写入。关闭时，它们会色调映射为 SDR。"
          }
        }
      }
    },
