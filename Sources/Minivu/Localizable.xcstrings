          }
        }
      }
    },
    "Edits are applied to every image first, then the size and orientation below. The watermark is stamped last, at the converted size." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সম্পাদনাগুলো প্রথমে প্রতিটি ছবিতে প্রয়োগ করা হয়, তারপর নিচের আকার এবং ওরিয়েন্টেশন। ওয়াটারমার্ক সবশেষে, রূপান্তরিত আকারে বসানো হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bearbeitungen werden zuerst auf jedes Bild angewendet, danach Größe und Ausrichtung unten. Das Wasserzeichen wird zuletzt in der konvertierten Größe aufgebracht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las ediciones se aplican primero a todas las imágenes y después el tamaño y la orientación de abajo. La marca de agua se estampa al final, al tamaño convertido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les modifications sont d’abord appliquées à chaque image, puis la taille et l’orientation ci-dessous. Le filigrane est apposé en dernier, à la taille convertie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "સંપાદનો પહેલાં દરેક ઇમેજ પર લાગુ થાય છે, પછી નીચેનું કદ અને ઓરિએન્ટેશન. વૉટરમાર્ક છેલ્લે, કન્વર્ટ કરેલા કદ પર લાગે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "संपादन पहले हर इमेज पर लागू होते हैं, फिर नीचे दिया गया आकार और ओरिएंटेशन। वॉटरमार्क सबसे अंत में, कन्वर्ट किए गए आकार पर लगाया जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le modifiche vengono prima applicate a ogni immagine, poi le dimensioni e l’orientamento indicati sotto. La filigrana viene applicata per ultima, alle dimensioni convertite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "編集内容はまずすべてのイメージに適用され、そのあとで下のサイズと向きが適用されます。透かしは最後に、変換後のサイズで入れられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "편집 내용이 먼저 모든 이미지에 적용된 다음, 아래의 크기와 방향이 적용됩니다. 워터마크는 마지막에 변환된 크기로 찍힙니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bewerkingen worden eerst op elke afbeelding toegepast, daarna de grootte en oriëntatie hieronder. Het watermerk wordt als laatste aangebracht, op de geconverteerde grootte."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਸੋਧਾਂ ਪਹਿਲਾਂ ਹਰ ਚਿੱਤਰ ’ਤੇ ਲਾਗੂ ਹੁੰਦੀਆਂ ਹਨ, ਫਿਰ ਹੇਠਾਂ ਦਿੱਤਾ ਆਕਾਰ ਅਤੇ ਓਰੀਐਂਟੇਸ਼ਨ। ਵਾਟਰਮਾਰਕ ਸਭ ਤੋਂ ਅਖੀਰ ਵਿੱਚ, ਕਨਵਰਟ ਕੀਤੇ ਆਕਾਰ ’ਤੇ ਲਗਾਇਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zmiany są najpierw stosowane do każdego obrazu, a potem rozmiar i orientacja ustawione poniżej. Znak wodny jest nakładany na końcu, w rozmiarze po konwersji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As edições são aplicadas primeiro a cada imagem, depois o tamanho e a orientação abaixo. A marca-d’água é aplicada por último, no tamanho convertido."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "திருத்தங்கள் முதலில் ஒவ்வொரு படத்துக்கும் பயன்படுத்தப்படும், பின்னர் கீழே உள்ள அளவும் திசையமைவும். நீர்க்குறி கடைசியாக, மாற்றப்பட்ட அளவில் பதிக்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "编辑会先应用到每张图像，然后再应用下方的尺寸和方向。水印最后以转换后的尺寸加上。"
          }
        }
      }
    },
