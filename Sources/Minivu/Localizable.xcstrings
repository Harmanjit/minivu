  "strings" : {
    "" : {
      "shouldTranslate" : false
    },
    " — limit reached, not every image is shown" : {
      "comment" : "Appended to the status bar text: keep the leading space and dash"
    },
    "%" : {
      "shouldTranslate" : false
    },
    "%@ %@" : {
      "comment" : "Two sentences, one after the other",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@ (coming soon)" : {
      "comment" : "Tooltip: %@ is a tool not available yet"
    },
    "%@ (stored in %lld segments)" : {
      "comment" : "Length of a long JPEG comment; %1$@ is a byte count such as “70,000 bytes”, %2$lld the number of JPEG COM segments",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
