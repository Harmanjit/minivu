    "%@ holds one picture, so each page of a PDF, multi-page TIFF or animation becomes a file of its own, numbered." : {
      "comment" : "%@ is a format such as JPEG",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ একটি মাত্র ছবি ধারণ করে, তাই PDF, মাল্টি-পেজ TIFF বা অ্যানিমেশনের প্রতিটি পৃষ্ঠা আলাদা একটি সংখ্যাযুক্ত ফাইল হয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ enthält nur ein Bild, daher wird jede Seite eines PDF, eines mehrseitigen TIFF oder einer Animation zu einer eigenen, nummerierten Datei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ admite una sola imagen, así que cada página de un PDF, un TIFF multipágina o una animación se convierte en un archivo independiente y numerado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ne contient qu’une image : chaque page d’un PDF, d’un TIFF multipage ou d’une animation devient donc un fichier distinct, numéroté."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@માં એક જ ચિત્ર રહે છે, તેથી PDF, મલ્ટિ-પેજ TIFF અથવા એનિમેશનનું દરેક પેજ નંબરવાળી અલગ ફાઇલ બને છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ में एक ही तस्वीर होती है, इसलिए PDF, मल्टी-पेज TIFF या एनिमेशन का हर पेज अपनी अलग, क्रमांकित फ़ाइल बन जाता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ contiene una sola immagine, quindi ogni pagina di un PDF, di un TIFF multipagina o di un’animazione diventa un file a sé, numerato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@には1枚のピクチャしか保存できないため、PDF、マルチページTIFF、アニメーションの各ページは連番付きの個別のファイルになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에는 사진을 하나만 담을 수 있으므로 PDF, 다중 페이지 TIFF 또는 애니메이션의 각 페이지가 번호가 붙은 개별 파일이 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ bevat één afbeelding, dus elke pagina van een PDF, TIFF met meerdere pagina’s of animatie wordt een apart, genummerd bestand."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ਵਿੱਚ ਇੱਕ ਹੀ ਤਸਵੀਰ ਹੁੰਦੀ ਹੈ, ਇਸ ਲਈ PDF, ਬਹੁ-ਪੰਨਾ TIFF ਜਾਂ ਐਨੀਮੇਸ਼ਨ ਦਾ ਹਰ ਪੰਨਾ ਆਪਣੀ ਵੱਖਰੀ ਨੰਬਰ ਵਾਲੀ ਫ਼ਾਈਲ ਬਣ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ mieści jeden obraz, więc każda strona pliku PDF, wielostronicowego pliku TIFF lub animacji staje się osobnym, numerowanym plikiem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ comporta uma única imagem; por isso, cada página de um PDF, TIFF de várias páginas ou animação vira um arquivo próprio, numerado."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ஒரு படத்தை மட்டுமே வைத்திருக்கும், எனவே PDF, பல பக்க TIFF அல்லது அனிமேஷனின் ஒவ்வொரு பக்கமும் தனித் தனி ஃபைலாக, எண்ணிடப்பட்டு உருவாகும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 只能容纳一张图片，因此 PDF、多页 TIFF 或动画的每一页都会成为单独的文件，并按顺序编号。"
          }
        }
      }
    },
