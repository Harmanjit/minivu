    "%@ The ratings are kept in minivu all the same. Later failures in this session aren’t reported." : {
      "comment" : "Alert detail; %@ is the reason the first write failed, a sentence",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ তবুও রেটিংগুলো minivu-তে রাখা হয়। এই সেশনে পরের ব্যর্থতাগুলো জানানো হবে না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Die Bewertungen werden trotzdem in minivu gespeichert. Spätere Fehler in dieser Sitzung werden nicht gemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Las valoraciones se conservan igualmente en minivu. No se informará de otros fallos durante esta sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Les notes sont tout de même conservées dans minivu. Les échecs suivants au cours de cette session ne seront pas signalés."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ તેમ છતાં રેટિંગ minivuમાં રાખવામાં આવે છે. આ સત્રમાં પછીની નિષ્ફળતાઓની જાણ કરવામાં આવશે નહીં."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ फिर भी रेटिंग minivu में रखी जाती हैं। इस सत्र में बाद की विफलताओं की सूचना नहीं दी जाएगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Le valutazioni vengono comunque conservate in minivu. Gli errori successivi in questa sessione non verranno segnalati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@評価は引き続きminivuに保持されます。このセッションでのこれ以降の失敗は報告されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 등급은 그래도 minivu에 보관됩니다. 이 세션에서 이후에 발생하는 실패는 보고되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ De waarderingen blijven toch bewaard in minivu. Latere fouten in deze sessie worden niet gemeld."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ਫਿਰ ਵੀ ਰੇਟਿੰਗਾਂ minivu ਵਿੱਚ ਰੱਖੀਆਂ ਜਾਂਦੀਆਂ ਹਨ। ਇਸ ਸੈਸ਼ਨ ਵਿੱਚ ਬਾਅਦ ਦੀਆਂ ਅਸਫਲਤਾਵਾਂ ਦੀ ਰਿਪੋਰਟ ਨਹੀਂ ਕੀਤੀ ਜਾਂਦੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Oceny i tak są zachowywane w minivu. Kolejne błędy w tej sesji nie będą zgłaszane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ As classificações continuam guardadas no minivu mesmo assim. Falhas posteriores nesta sessão não serão informadas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ இருந்தாலும் மதிப்பீடுகள் minivu-இல் வைக்கப்படும். இந்த அமர்வில் பின்னர் ஏற்படும் தோல்விகள் தெரிவிக்கப்படாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 评分仍会保留在 minivu 中。本次会话中之后的失败将不再报告。"
          }
        }
      }
    },
    "%@ aren’t among the images being converted, but converted files would take their names." : {
      "comment" : "%@ is a list of file names in quotation marks",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ রূপান্তরিত হওয়া ছবিগুলোর মধ্যে নেই, কিন্তু রূপান্তরিত ফাইলগুলো তাদের নাম নেবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ gehören nicht zu den konvertierten Bildern, aber konvertierte Dateien würden ihre Namen erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ no están entre las imágenes que se convierten, pero los archivos convertidos tomarían sus nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ne font pas partie des images en cours de conversion, mais des fichiers convertis prendraient leur nom."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ કન્વર્ટ થઈ રહેલી ઇમેજમાં નથી, પરંતુ કન્વર્ટ થયેલી ફાઇલો તેમનાં નામ લઈ લેશે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ कन्वर्ट की जा रही इमेज में नहीं हैं, लेकिन कन्वर्ट की गई फ़ाइलें उनके नाम ले लेंगी।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non sono tra le immagini da convertire, ma i file convertiti ne prenderebbero i nomi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@は変換対象のイメージではありませんが、変換後のファイルがこれらの名前になってしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) 변환 중인 이미지가 아니지만, 변환된 파일이 그 이름을 갖게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ horen niet bij de afbeeldingen die worden geconverteerd, maar geconverteerde bestanden zouden hun namen krijgen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ਕਨਵਰਟ ਕੀਤੇ ਜਾ ਰਹੇ ਚਿੱਤਰਾਂ ਵਿੱਚ ਸ਼ਾਮਲ ਨਹੀਂ ਹਨ, ਪਰ ਕਨਵਰਟ ਕੀਤੀਆਂ ਫ਼ਾਈਲਾਂ ਉਹਨਾਂ ਦੇ ਨਾਮ ਲੈ ਲੈਣਗੀਆਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ nie należą do konwertowanych obrazów, ale przekonwertowane pliki przyjęłyby ich nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ não estão entre as imagens a converter, mas os arquivos convertidos receberiam esses nomes."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ மாற்றப்படும் படங்களில் இல்லை, ஆனால் மாற்றப்பட்ட ஃபைல்கள் அவற்றின் பெயர்களை எடுத்துக்கொள்ளும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
