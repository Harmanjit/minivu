        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "કંઈ ટિક ન કર્યું હોય તો દરેક પ્રકાર દેખાય છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कुछ भी न चुना हो तो हर प्रकार दिखता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se non selezioni nulla, vengono mostrati tutti i tipi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "何もチェックしない場合は、すべての種類が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아무것도 선택하지 않으면 모든 유형이 표시됩니다."
