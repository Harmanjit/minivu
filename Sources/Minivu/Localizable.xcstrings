    "This works best on a photo with a clear subject, such as a person, a pet or an object, standing out from its background." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies funktioniert am besten bei einem Foto mit einem klaren Motiv, etwa einer Person, einem Haustier oder einem Gegenstand, das sich vom Hintergrund abhebt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funciona mejor con una foto que tenga un sujeto claro, como una persona, una mascota o un objeto, que destaque sobre el fondo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cela fonctionne mieux sur une photo dont le sujet est net, comme une personne, un animal ou un objet, et se détache de l’arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funziona meglio con una foto con un soggetto chiaro, come una persona, un animale o un oggetto, che si stacca dallo sfondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "人物、ペット、物など、背景から際立ったはっきりした被写体がある写真に最適です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "사람, 반려동물 또는 사물처럼 배경에서 뚜렷하게 구분되는 피사체가 있는 사진에서 가장 잘 작동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit werkt het best bij een foto met een duidelijk onderwerp, zoals een persoon, een huisdier of een voorwerp, dat afsteekt tegen de achtergrond."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Działa to najlepiej na zdjęciu z wyraźnym obiektem, takim jak osoba, zwierzę lub przedmiot, odcinającym się od tła."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Funciona melhor em uma foto com um motivo claro, como uma pessoa, um animal de estimação ou um objeto, que se destaque do fundo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此功能最适合主体清晰的照片，例如从背景中突出的人物、宠物或物体。"
          }
        }
      }
    },
