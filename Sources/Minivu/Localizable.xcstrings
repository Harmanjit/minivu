        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "गिनती के लिए हर पिक्सेल को पूरे आकार में पढ़ा जाता है, जिसके लिए इस इमेज के बाद बची मेमोरी से अधिक मेमोरी चाहिए"
