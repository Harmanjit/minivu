    "Slideshows play full screen on the display chosen for the full-screen viewer in Viewer settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diashows werden im Vollbildmodus auf dem Display abgespielt, das in den Betrachter-Einstellungen für den Vollbild-Betrachter gewählt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los pases de diapositivas se reproducen a pantalla completa en la pantalla elegida para el visor a pantalla completa en los ajustes del visor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les diaporamas sont lus en plein écran sur l’écran choisi pour la visionneuse plein écran dans les réglages Visionneuse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le presentazioni vengono riprodotte a tutto schermo sul monitor scelto per il visore a tutto schermo nelle impostazioni del visore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スライドショーは、「ビューア」設定でフルスクリーンビューア用に選択したディスプレイでフルスクリーン再生されます。"
