    "In %lld groups every file is marked, so no copy of them will be left here. You can put them back from the Trash in Finder." : {
      "comment" : "Before moving duplicates to the Trash",
      "localizations" : {
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lldটি গ্রুপে প্রতিটি ফাইল চিহ্নিত, তাই এগুলোর কোনো কপিই এখানে থাকবে না। আপনি Finder-এ ট্র্যাশ থেকে সেগুলো ফিরিয়ে আনতে পারেন।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "%lldটি গ্রুপে প্রতিটি ফাইল চিহ্নিত, তাই এগুলোর কোনো কপিই এখানে থাকবে না। আপনি Finder-এ ট্র্যাশ থেকে সেগুলো ফিরিয়ে আনতে পারেন।"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
