    "The bottom is three and a half times as deep. Widths are percentages of the photo’s short side." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Unten ist der Rand dreieinhalbmal so tief. Die Breiten sind Prozentwerte der kurzen Seite des Fotos."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La parte inferior es tres veces y media más ancha. Las anchuras son porcentajes del lado corto de la foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le bas est trois fois et demie plus profond. Les largeurs sont des pourcentages du petit côté de la photo."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il lato inferiore è profondo tre volte e mezzo. Le larghezze sono percentuali del lato corto della foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "下辺の幅は3.5倍になります。幅は写真の短辺に対するパーセントです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "아래쪽은 3.5배 더 깊습니다. 너비는 사진의 짧은 변에 대한 백분율입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De onderkant is drieënhalf keer zo diep. Breedtes zijn percentages van de korte zijde van de foto."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dół jest trzy i pół raza głębszy. Szerokości są procentem krótszego boku zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A parte de baixo é três vezes e meia mais funda. As larguras são porcentagens do lado menor da foto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "底部的宽度是其他边的三倍半。宽度是照片短边的百分比。"
          }
        }
      }
    },
