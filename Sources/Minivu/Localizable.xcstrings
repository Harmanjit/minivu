    "Marks every file but the one suggested to keep in each group" : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি গ্রুপে রাখার জন্য প্রস্তাবিতটি ছাড়া প্রতিটি ফাইল চিহ্নিত করে"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Markiert in jeder Gruppe alle Dateien außer der, die zum Behalten vorgeschlagen ist"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Señala todos los archivos de cada grupo menos el que se sugiere conservar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Coche tous les fichiers sauf celui qu’il est suggéré de garder dans chaque groupe"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "દરેક ગ્રુપમાં રાખવા માટે સૂચવેલી ફાઇલ સિવાયની દરેક ફાઇલને ચિહ્નિત કરે છે"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर समूह में रखने के लिए सुझाई गई फ़ाइल को छोड़कर हर फ़ाइल मार्क करता है"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Contrassegna tutti i file tranne quello suggerito da mantenere in ogni gruppo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各グループで、残すことを推奨されたファイル以外のすべてのファイルにマークを付けます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 그룹에서 유지하도록 추천된 파일을 제외한 모든 파일을 표시합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vinkt in elke groep alle bestanden aan behalve het bestand dat wordt voorgesteld om te behouden"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਹਰ ਸਮੂਹ ਵਿੱਚ ਰੱਖਣ ਲਈ ਸੁਝਾਈ ਗਈ ਫ਼ਾਈਲ ਤੋਂ ਇਲਾਵਾ ਹਰ ਫ਼ਾਈਲ ਨਿਸ਼ਾਨਬੱਧ ਕਰਦਾ ਹੈ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wskazuje w każdej grupie wszystkie pliki z wyjątkiem sugerowanego do zachowania"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Marca todos os arquivos, exceto o sugerido para manter, em cada grupo"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ஒவ்வொரு குழுவிலும் வைத்திருக்கப் பரிந்துரைக்கப்பட்டதைத் தவிர மற்ற எல்லா ஃபைல்களையும் குறிக்கும்"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "勾选每个组中除建议保留文件外的所有文件"
          }
        }
      }
    },
