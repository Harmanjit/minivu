    "%@ isn’t one of the images being converted, but a converted file would take its name." : {
      "comment" : "%@ is a file name in quotation marks",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ রূপান্তরিত হওয়া ছবিগুলোর একটি নয়, কিন্তু একটি রূপান্তরিত ফাইল এর নাম নেবে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ gehört nicht zu den konvertierten Bildern, aber eine konvertierte Datei würde ihren Namen erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ no es una de las imágenes que se convierten, pero un archivo convertido tomaría su nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ne fait pas partie des images en cours de conversion, mais un fichier converti prendrait son nom."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ કન્વર્ટ થઈ રહેલી ઇમેજમાંની એક નથી, પરંતુ કન્વર્ટ થયેલી ફાઇલ તેનું નામ લઈ લેશે."
