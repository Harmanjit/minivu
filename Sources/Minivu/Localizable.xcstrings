    "A canvas smaller than the image crops it about the anchor." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ছবির চেয়ে ছোট ক্যানভাস অ্যাঙ্কর অনুযায়ী ছবিটি ক্রপ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine Arbeitsfläche, die kleiner als das Bild ist, beschneidet es um den Ankerpunkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un lienzo más pequeño que la imagen la recorta alrededor del punto de anclaje."
