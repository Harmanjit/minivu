        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ कन्वर्ट की जा रही इमेज में से एक नहीं है, लेकिन कोई कन्वर्ट की गई फ़ाइल उसका नाम ले लेगी।"
          }
