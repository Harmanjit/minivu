    "%@ The ratings are kept in minivu all the same. Later failures in this session aren’t reported." : {
      "comment" : "Alert detail; %@ is the reason the first write failed, a sentence",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Die Bewertungen werden trotzdem in minivu gespeichert. Spätere Fehler in dieser Sitzung werden nicht gemeldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Las valoraciones se conservan igualmente en minivu. No se informará de otros fallos durante esta sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Les notes sont tout de même conservées dans minivu. Les échecs suivants au cours de cette session ne seront pas signalés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Le valutazioni vengono comunque conservate in minivu. Gli errori successivi in questa sessione non verranno segnalati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@評価は引き続きminivuに保持されます。このセッションでのこれ以降の失敗は報告されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 등급은 그래도 minivu에 보관됩니다. 이 세션에서 이후에 발생하는 실패는 보고되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ De waarderingen blijven toch bewaard in minivu. Latere fouten in deze sessie worden niet gemeld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ Oceny i tak są zachowywane w minivu. Kolejne błędy w tej sesji nie będą zgłaszane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ As classificações continuam guardadas no minivu mesmo assim. Falhas posteriores nesta sessão não serão informadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 评分仍会保留在 minivu 中。本次会话中之后的失败将不再报告。"
          }
        }
      }
    },
    "%@ aren’t among the images being converted, but converted files would take their names." : {
      "comment" : "%@ is a list of file names in quotation marks",
      "localizations" : {
        "de" : {
