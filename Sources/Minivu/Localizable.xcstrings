        }
      }
    },
    "%@ Contact Sheet" : {
      "comment" : "Suggested file name: a folder's name or the header, then Contact Sheet"
    },
    "%@ Edits" : {
      "comment" : "Suggested preset name: a photo's name, then Edits"
    },
    "%@ Pictures are written in sRGB; HDR photos are shown as on a standard display." : {
      "comment" : "%@ is a whole sentence about the chosen format; this second sentence follows it"
    },
    "%@ Slideshow" : {
      "comment" : "Suggested video file name: the pictures' folder, then Slideshow"
    },
    "%@ Strip" : {
      "comment" : "Suggested file name: the first picture's name, then Strip"
    },
    "%@ The ratings are kept in minivu all the same. Later failures in this session aren’t reported." : {
      "comment" : "Alert detail; %@ is the reason the first write failed, a sentence"
    },
    "%@ aren’t among the images being converted, but converted files would take their names." : {
      "comment" : "%@ is a list of file names in quotation marks"
    },
    "%@ at quality %lld" : {
      "comment" : "%1$@ is a file format such as JPEG, %2$lld a quality from 1 to 100",
      "localizations" : {
