            "value" : "ਇਹ ਸਮਾਰਟ ਫ਼ੋਲਡਰ ਮਿਟਾ ਦਿੱਤਾ ਗਿਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
