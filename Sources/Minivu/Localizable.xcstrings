    "Replaced files go to the Trash. Keep Both gives the converted files numbered names instead." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিস্থাপিত ফাইলগুলো ট্র্যাশে যায়। ‘দুটোই রাখুন’ বেছে নিলে রূপান্তরিত ফাইলগুলো পরিবর্তে সংখ্যাযুক্ত নাম পায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ersetzte Dateien werden in den Papierkorb gelegt. „Beide behalten“ gibt den konvertierten Dateien stattdessen nummerierte Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los archivos reemplazados van a la papelera. Conservar ambos da en su lugar nombres numerados a los archivos convertidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les fichiers remplacés sont placés dans la corbeille. Garder les deux attribue plutôt des noms numérotés aux fichiers convertis."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "જેની જગ્યાએ નવી ફાઇલ આવી તે જૂની ફાઇલો ટ્રેશમાં જાય છે. “બંને રાખો” તેના બદલે કન્વર્ટ કરેલી ફાઇલોને નંબરવાળાં નામ આપે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बदली गई फ़ाइलें ट्रैश में जाती हैं। “दोनों रखें” इसके बजाय कन्वर्ट की गई फ़ाइलों को क्रमांकित नाम देता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I file sostituiti vengono spostati nel Cestino. Mantieni entrambi assegna invece ai file convertiti nomi numerati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "置き換えられたファイルはゴミ箱に入ります。「両方を残す」を選ぶと、変換後のファイルに連番付きの名前が付けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "대치된 파일은 휴지통으로 이동합니다. 모두 유지를 선택하면 변환된 파일에 번호가 붙은 이름이 지정됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vervangen bestanden gaan naar de prullenmand. ‘Bewaar beide’ geeft de geconverteerde bestanden in plaats daarvan genummerde namen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਜਿਨ੍ਹਾਂ ਪੁਰਾਣੀਆਂ ਫ਼ਾਈਲਾਂ ਦੀ ਥਾਂ ਨਵੀਆਂ ਰੱਖੀਆਂ ਜਾਂਦੀਆਂ ਹਨ, ਉਹ ਰੱਦੀ ਵਿੱਚ ਜਾਂਦੀਆਂ ਹਨ। “ਦੋਵੇਂ ਰੱਖੋ” ਇਸਦੀ ਬਜਾਏ ਕਨਵਰਟ ਕੀਤੀਆਂ ਫ਼ਾਈਲਾਂ ਨੂੰ ਨੰਬਰ ਵਾਲੇ ਨਾਮ ਦਿੰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zastąpione pliki trafiają do kosza. Zachowaj oba nadaje zamiast tego przekonwertowanym plikom numerowane nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Os arquivos substituídos vão para o Lixo. Manter Ambos dá nomes numerados aos arquivos convertidos."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "பழைய ஃபைல்கள் குப்பைக்கு நகர்த்தப்படும். “இரண்டையும் வைத்திரு” என்பதைத் தேர்ந்தெடுத்தால், மாற்றப்பட்ட ஃபைல்களுக்கு எண்ணிட்ட பெயர்கள் கொடுக்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "被替换的文件会移到废纸篓。“保留两者”会改为给转换后的文件加上编号名称。"
          }
        }
      }
    },
