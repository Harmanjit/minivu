    "None of these edits can be used on other photos, so there is nothing to save." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই সম্পাদনাগুলোর কোনোটিই অন্য ফটোতে ব্যবহার করা যায় না, তাই সেভ করার কিছু নেই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keine dieser Bearbeitungen kann auf andere Fotos angewendet werden, daher gibt es nichts zu sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ninguna de estas ediciones se puede usar en otras fotos, así que no hay nada que guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucune de ces modifications ne peut s’appliquer à d’autres photos : il n’y a donc rien à enregistrer."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "આમાંનું કોઈ સંપાદન અન્ય ફોટો પર વાપરી શકાતું નથી, તેથી સાચવવા માટે કંઈ નથી."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इनमें से कोई भी संपादन दूसरी फ़ोटो पर इस्तेमाल नहीं किया जा सकता, इसलिए सहेजने के लिए कुछ नहीं है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nessuna di queste modifiche può essere usata su altre foto, quindi non c’è nulla da salvare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これらの編集はどれもほかの写真に使用できないため、保存するものがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 편집 내용 중 다른 사진에 사용할 수 있는 것이 없으므로 저장할 항목이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Geen van deze bewerkingen kan op andere foto’s worden gebruikt, dus er valt niets te bewaren."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਇਹਨਾਂ ਵਿੱਚੋਂ ਕੋਈ ਵੀ ਸੋਧ ਹੋਰ ਫ਼ੋਟੋਆਂ ’ਤੇ ਨਹੀਂ ਵਰਤੀ ਜਾ ਸਕਦੀ, ਇਸ ਲਈ ਸੰਭਾਲਣ ਲਈ ਕੁਝ ਨਹੀਂ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Żadnej z tych zmian nie można użyć na innych zdjęciach, więc nie ma czego zachować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nenhuma destas edições pode ser usada em outras fotos, por isso não há nada para salvar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இந்தத் திருத்தங்கள் எதையும் பிற புகைப்படங்களில் பயன்படுத்த முடியாது, எனவே சேமிக்க எதுவும் இல்லை."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这些编辑都无法用于其他照片，因此没有可存储的内容。"
          }
        }
      }
    },
