    "%lld of them can’t be rewritten (camera raw, or a format ImageIO can’t rewrite), so the metadata goes in an XMP sidecar beside each." : {
      "comment" : "Metadata editor header, after the number of images being edited",
      "localizations" : {
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "এগুলোর মধ্যে %lldটি পুনরায় লেখা যায় না (ক্যামেরা RAW, বা এমন ফরম্যাট যা ImageIO পুনরায় লিখতে পারে না), তাই মেটাডেটা প্রতিটির পাশে একটি XMP সাইডকারে যায়।"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "needs_review",
                  "value" : "এগুলোর মধ্যে %lldটি পুনরায় লেখা যায় না (ক্যামেরা RAW, বা এমন ফরম্যাট যা ImageIO পুনরায় লিখতে পারে না), তাই মেটাডেটা প্রতিটির পাশে একটি XMP সাইডকারে যায়।"
                }
