    "%@. Fields that differ show as mixed; only fields you change are written." : {
      "comment" : "Metadata editor header; %@ is a number of images, such as “12 images”",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@। যে ফিল্ডগুলো আলাদা সেগুলো মিশ্র দেখায়; শুধু আপনি যে ফিল্ডগুলো পরিবর্তন করেন সেগুলোই লেখা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Abweichende Felder werden als gemischt angezeigt; nur Felder, die du änderst, werden geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Los campos que difieren se muestran como mixtos; solo se escriben los campos que cambies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Les champs qui diffèrent apparaissent comme mixtes ; seuls les champs que vous modifiez sont écrits."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. જુદા હોય તેવાં ફીલ્ડ મિશ્ર તરીકે દેખાય છે; ફક્ત તમે બદલો છો તે ફીલ્ડ જ લખવામાં આવે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@। जिन फ़ील्ड के मान अलग-अलग हैं वे मिश्रित दिखते हैं; केवल वही फ़ील्ड लिखे जाते हैं जिन्हें आप बदलते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. I campi che differiscono sono indicati come misti; vengono scritti solo i campi che modifichi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@。値が異なるフィールドは混在として表示されます。書き込まれるのは変更したフィールドだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. 서로 다른 필드는 혼합으로 표시되며, 변경한 필드만 기록됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Velden die verschillen, worden als gemengd getoond; alleen velden die je wijzigt, worden geschreven."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@। ਵੱਖਰੇ ਮੁੱਲਾਂ ਵਾਲੇ ਖੇਤਰ ਮਿਸ਼ਰਤ ਵਜੋਂ ਦਿਸਦੇ ਹਨ; ਸਿਰਫ਼ ਉਹ ਖੇਤਰ ਲਿਖੇ ਜਾਂਦੇ ਹਨ ਜੋ ਤੁਸੀਂ ਬਦਲਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Pola, które się różnią, są oznaczone jako mieszane; zapisywane są tylko zmienione pola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Os campos diferentes aparecem como mistos; só os campos que você alterar serão gravados."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. வேறுபடும் புலங்கள் கலப்பு எனக் காட்டப்படும்; நீங்கள் மாற்றும் புலங்கள் மட்டுமே எழுதப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@。不同的字段显示为混合值；仅写入你更改的字段。"
          }
        }
      }
    },
