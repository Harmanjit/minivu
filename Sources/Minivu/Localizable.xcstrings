    "Thumbnails are rebuilt from the original files the next time a folder is shown." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পরের বার কোনো ফোল্ডার দেখানো হলে আসল ফাইলগুলো থেকে থাম্বনেল আবার তৈরি হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Miniaturen werden beim nächsten Anzeigen eines Ordners aus den Originaldateien neu erstellt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las miniaturas se vuelven a generar a partir de los archivos originales la próxima vez que se muestre una carpeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les vignettes sont recréées à partir des fichiers originaux la prochaine fois qu’un dossier est affiché."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "આગલી વખતે ફોલ્ડર બતાવવામાં આવે ત્યારે થંબનેલ મૂળ ફાઇલોમાંથી ફરીથી બનાવવામાં આવે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अगली बार फ़ोल्डर दिखाए जाने पर थंबनेल मूल फ़ाइलों से फिर से बनाए जाते हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le miniature vengono ricreate dai file originali la prossima volta che viene visualizzata una cartella."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "サムネールは、次にフォルダを表示するときにオリジナルファイルから再作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다음에 폴더를 표시할 때 원본 파일로부터 축소판이 다시 생성됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Miniaturen worden opnieuw opgebouwd uit de originele bestanden wanneer een map de volgende keer wordt getoond."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਅਗਲੀ ਵਾਰ ਫ਼ੋਲਡਰ ਦਿਖਾਏ ਜਾਣ ’ਤੇ ਥੰਬਨੇਲ ਮੂਲ ਫ਼ਾਈਲਾਂ ਤੋਂ ਦੁਬਾਰਾ ਬਣਾਏ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Miniatury zostaną odtworzone z oryginalnych plików przy następnym wyświetleniu folderu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As miniaturas são recriadas a partir dos arquivos originais na próxima vez que uma pasta for exibida."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "அடுத்த முறை ஒரு ஃபோல்டர் காட்டப்படும்போது சிறுபடங்கள் அசல் ஃபைல்களிலிருந்து மீண்டும் உருவாக்கப்படும்."
          }
        },
