        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta pasta inteligente foi apagada."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இந்த ஸ்மார்ட் ஃபோல்டர் நீக்கப்பட்டது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
