    "Drag each corner onto a corner of something that should be rectangular, or set them in the tools panel." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি কোণ এমন কিছুর কোণে টেনে আনুন যা আয়তাকার হওয়া উচিত, অথবা টুল প্যানেলে সেগুলো সেট করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ziehe jede Ecke auf eine Ecke von etwas, das rechteckig sein sollte, oder lege sie im Werkzeugbereich fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrastra cada esquina hasta una esquina de algo que debería ser rectangular, o ajústalas en el panel de herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Faites glisser chaque coin sur un coin d’un objet qui devrait être rectangulaire, ou définissez-les dans le panneau des outils."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "દરેક ખૂણાને જે વસ્તુ લંબચોરસ હોવી જોઈએ તેના ખૂણા પર ખેંચો, અથવા ટૂલ્સ પૅનલમાં સેટ કરો."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर कोने को किसी ऐसी चीज़ के कोने पर ड्रैग करें जो आयताकार होनी चाहिए, या उन्हें टूल्स पैनल में सेट करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trascina ogni angolo sull’angolo di qualcosa che dovrebbe essere rettangolare, oppure impostali nel pannello degli strumenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各角を、長方形であるべきものの角までドラッグするか、ツールパネルで設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 모서리를 직사각형이어야 하는 대상의 모서리로 드래그하거나 도구 패널에서 설정하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sleep elke hoek naar een hoek van iets dat rechthoekig hoort te zijn, of stel ze in het gereedschapspaneel in."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਹਰ ਕੋਨੇ ਨੂੰ ਕਿਸੇ ਅਜਿਹੀ ਚੀਜ਼ ਦੇ ਕੋਨੇ ’ਤੇ ਘਸੀਟੋ ਜੋ ਆਇਤਾਕਾਰ ਹੋਣੀ ਚਾਹੀਦੀ ਹੈ, ਜਾਂ ਉਹਨਾਂ ਨੂੰ ਟੂਲ ਪੈਨਲ ਵਿੱਚ ਸੈੱਟ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Przeciągnij każdy narożnik na narożnik czegoś, co powinno być prostokątne, lub ustaw je w panelu narzędzi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arraste cada canto até um canto de algo que deveria ser retangular, ou defina-os no painel de ferramentas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "செவ்வகமாக இருக்க வேண்டிய ஒன்றின் மூலையின் மீது ஒவ்வொரு மூலையையும் இழுத்து வையுங்கள், அல்லது கருவிகள் பலகத்தில் அவற்றை அமையுங்கள்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "将每个角点拖到应为矩形的物体的角上，或在工具面板中设定。"
          }
        }
      }
    },
    "Drag inside the circle to move the lens, or its edge to resize it. Below 1× the lens pinches." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "লেন্স সরাতে বৃত্তের ভিতরে টানুন, অথবা আকার বদলাতে এর প্রান্ত টানুন। 1×-এর নিচে লেন্সটি সংকুচিত করে।"
