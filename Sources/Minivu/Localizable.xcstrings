    "Option-click where to copy from, then paint. ⌘Z removes the last stroke." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যেখান থেকে কপি করবেন সেখানে Option-ক্লিক করুন, তারপর রং করুন। ⌘Z শেষ স্ট্রোকটি সরিয়ে দেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Klicke bei gedrückter Wahltaste auf die Stelle, von der kopiert werden soll, und male dann. ⌘Z entfernt den letzten Strich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Haz clic con la tecla Opción pulsada en el punto desde el que copiar y luego pinta. ⌘Z elimina la última pincelada."
          }
        },
        "fr" : {
          "stringUnit" : {
