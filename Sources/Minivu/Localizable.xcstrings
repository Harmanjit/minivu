    "Each image opens in %@ on its own." : {
      "comment" : "%@ is an application's name",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি ছবি আলাদাভাবে %@-এ খোলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedes Bild wird einzeln in %@ geöffnet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada imagen se abre por separado en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque image s’ouvre séparément dans %@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "દરેક ઇમેજ %@માં અલગથી ખૂલે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर इमेज %@ में अलग से खुलती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni immagine si apre separatamente in %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各イメージが%@で個別に開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 이미지가 %@에서 개별적으로 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elke afbeelding wordt afzonderlijk geopend in %@."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਹਰ ਚਿੱਤਰ %@ ਵਿੱਚ ਵੱਖਰਾ ਖੁੱਲ੍ਹਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każdy obraz otworzy się w %@ osobno."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada imagem abre separadamente no %@."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ஒவ்வொரு படமும் %@-இல் தனித்தனியாகத் திறக்கும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每张图像会在“%@”中单独打开。"
          }
        }
      }
    },
    "Each image’s own date taken moves by the same amount." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি ছবির নিজস্ব তোলার তারিখ একই পরিমাণে সরে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Aufnahmedatum jedes Bilds wird um denselben Betrag verschoben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La fecha de captura de cada imagen se desplaza lo mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La date de prise de vue de chaque image est décalée de la même durée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "દરેક ઇમેજની પોતાની લીધાની તારીખ સમાન સમયથી ખસે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर इमेज के लेने की अपनी तिथि उतनी ही खिसकती है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La data di scatto di ogni immagine viene spostata della stessa quantità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各イメージの撮影日が同じだけずれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 이미지의 촬영일이 같은 양만큼 이동합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De eigen opnamedatum van elke afbeelding verschuift met dezelfde hoeveelheid."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਹਰ ਚਿੱਤਰ ਦੀ ਆਪਣੀ ਖਿੱਚਣ ਦੀ ਮਿਤੀ ਇੱਕੋ ਜਿੰਨੀ ਖਿਸਕਦੀ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Data wykonania każdego obrazu przesunie się o tę samą wartość."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A data da foto de cada imagem é deslocada na mesma quantidade."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ஒவ்வொரு படத்தின் சொந்த எடுத்த தேதியும் அதே அளவு நகரும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每张图像自身的拍摄日期会移动相同的量。"
          }
        }
      }
    },
    "Each page keeps its size and colour profile. Metadata isn’t carried over, and HDR photos come out SDR." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি পৃষ্ঠা তার আকার এবং রঙের প্রোফাইল রাখে। মেটাডেটা স্থানান্তরিত হয় না, এবং HDR ফটো SDR হয়ে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Seite behält ihre Größe und ihr Farbprofil. Metadaten werden nicht übernommen, und HDR-Fotos werden als SDR ausgegeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada página conserva su tamaño y su perfil de color. Los metadatos no se trasladan y las fotos HDR salen en SDR."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque page conserve sa taille et son profil colorimétrique. Les métadonnées ne sont pas reprises, et les photos HDR sont converties en SDR."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "દરેક પેજ પોતાનું કદ અને કલર પ્રોફાઇલ રાખે છે. મેટાડેટા સાથે આવતો નથી, અને HDR ફોટો SDR બને છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हर पेज अपना आकार और रंग प्रोफ़ाइल रखता है। मेटाडेटा साथ नहीं आता, और HDR फ़ोटो SDR बन जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni pagina mantiene le proprie dimensioni e il proprio profilo colore. I metadati non vengono trasferiti e le foto HDR diventano SDR."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "各ページのサイズとカラープロファイルは保持されます。メタデータは引き継がれず、HDR写真はSDRになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "각 페이지는 크기와 색상 프로파일을 유지합니다. 메타데이터는 옮겨지지 않으며, HDR 사진은 SDR로 출력됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elke pagina behoudt haar grootte en kleurprofiel. Metagegevens worden niet overgenomen en HDR-foto’s worden SDR."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਹਰ ਪੰਨਾ ਆਪਣਾ ਆਕਾਰ ਅਤੇ ਰੰਗ ਪ੍ਰੋਫ਼ਾਈਲ ਰੱਖਦਾ ਹੈ। ਮੈਟਾਡਾਟਾ ਨਾਲ ਨਹੀਂ ਜਾਂਦਾ, ਅਤੇ HDR ਫ਼ੋਟੋਆਂ SDR ਬਣ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każda strona zachowuje swój rozmiar i profil kolorów. Metadane nie są przenoszone, a zdjęcia HDR są zapisywane jako SDR."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada página mantém seu tamanho e perfil de cor. Os metadados não são transferidos, e as fotos HDR saem em SDR."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ஒவ்வொரு பக்கமும் அதன் அளவையும் வண்ணச் சுயவிவரத்தையும் வைத்திருக்கும். மெட்டாடேட்டா எடுத்துச்செல்லப்படாது, HDR புகைப்படங்கள் SDR-ஆக வெளிவரும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "每一页保留其尺寸和颜色描述文件。元数据不会保留，HDR 照片会输出为 SDR。"
          }
        }
      }
    },
    "Each page of a PDF or multi-page TIFF, or each frame of an animation, is written as a file of its own. Files with one page are skipped." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF বা মাল্টি-পেজ TIFF-এর প্রতিটি পৃষ্ঠা, বা অ্যানিমেশনের প্রতিটি ফ্রেম, আলাদা ফাইল হিসেবে লেখা হয়। এক পৃষ্ঠার ফাইলগুলো এড়িয়ে যাওয়া হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jede Seite eines PDF oder mehrseitigen TIFF bzw. jeder Frame einer Animation wird als eigene Datei geschrieben. Dateien mit nur einer Seite werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada página de un PDF o TIFF multipágina, o cada fotograma de una animación, se escribe como un archivo independiente. Los archivos de una sola página se omiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Chaque page d’un PDF ou d’un TIFF multipage, ou chaque image d’une animation, est écrite dans un fichier distinct. Les fichiers d’une seule page sont ignorés."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF અથવા મલ્ટિ-પેજ TIFFનું દરેક પેજ, અથવા એનિમેશનની દરેક ફ્રેમ, અલગ ફાઇલ તરીકે લખાય છે. એક પેજવાળી ફાઇલો છોડી દેવામાં આવે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF या मल्टी-पेज TIFF का हर पेज, या एनिमेशन का हर फ़्रेम, अपनी अलग फ़ाइल के रूप में लिखा जाता है। एक पेज वाली फ़ाइलें छोड़ दी जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ogni pagina di un PDF o di un TIFF multipagina, o ogni fotogramma di un’animazione, viene scritta come file a sé. I file con una sola pagina vengono saltati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDFやマルチページTIFFの各ページ、またはアニメーションの各フレームが、それぞれ個別のファイルとして書き出されます。1ページだけのファイルはスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF 또는 다중 페이지 TIFF의 각 페이지나 애니메이션의 각 프레임이 개별 파일로 기록됩니다. 페이지가 하나인 파일은 건너뜁니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elke pagina van een PDF of TIFF met meerdere pagina’s, of elk frame van een animatie, wordt als een apart bestand geschreven. Bestanden met één pagina worden overgeslagen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF ਜਾਂ ਬਹੁ-ਪੰਨਾ TIFF ਦਾ ਹਰ ਪੰਨਾ, ਜਾਂ ਐਨੀਮੇਸ਼ਨ ਦਾ ਹਰ ਫ਼ਰੇਮ, ਆਪਣੀ ਵੱਖਰੀ ਫ਼ਾਈਲ ਵਜੋਂ ਲਿਖਿਆ ਜਾਂਦਾ ਹੈ। ਇੱਕ ਪੰਨੇ ਵਾਲੀਆਂ ਫ਼ਾਈਲਾਂ ਛੱਡ ਦਿੱਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Każda strona pliku PDF lub wielostronicowego pliku TIFF albo każda klatka animacji jest zapisywana jako osobny plik. Pliki z jedną stroną są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cada página de um PDF ou TIFF de várias páginas, ou cada quadro de uma animação, é gravado como um arquivo próprio. Arquivos com uma única página são ignorados."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF அல்லது பல பக்க TIFF-இன் ஒவ்வொரு பக்கமும், அனிமேஷனின் ஒவ்வொரு ஃபிரேமும் தனி ஃபைலாக எழுதப்படும். ஒரு பக்கம் உள்ள ஃபைல்கள் தவிர்க்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "PDF 或多页 TIFF 的每一页，或动画的每一帧，都会写为单独的文件。只有一页的文件会被跳过。"
          }
        }
      }
    },
    "Each picture is fitted into its cell, centred. Cells take the pictures’ middle shape." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি ছবি তার ঘরে মাঝখানে বসানো হয়। ঘরগুলো ছবিগুলোর মাঝামাঝি আকৃতি নেয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jedes Bild wird zentriert in seine Zelle eingepasst. Die Zellen nehmen die mittlere Form der Bilder an."
          }
        },
        "es" : {
          "stringUnit" : {
