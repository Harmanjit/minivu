            "state" : "needs_review",
            "value" : "El espaciado y el margen deben estar entre 0 y 1000 píxeles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’espacement et la marge doivent être compris entre 0 et 1 000 pixels."
          }
        },
        "it" : {
          "stringUnit" : {
