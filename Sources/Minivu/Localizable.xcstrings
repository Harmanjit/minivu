    "One PDF with every page; pictures are embedded at the size of their cells." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "প্রতিটি পৃষ্ঠাসহ একটি PDF; ছবিগুলো তাদের ঘরের আকারে এম্বেড করা হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein PDF mit allen Seiten; die Bilder werden in der Größe ihrer Zellen eingebettet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un PDF con todas las páginas; las imágenes se incrustan al tamaño de sus celdas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un seul PDF avec toutes les pages ; les images sont intégrées à la taille de leur cellule."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "દરેક પેજ સાથે એક PDF; ચિત્રો તેમના સેલના કદમાં એમ્બેડ થાય છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "सभी पेज वाला एक PDF; तस्वीरें अपने सेल के आकार में एम्बेड की जाती हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un unico PDF con tutte le pagine; le immagini vengono incorporate alle dimensioni delle celle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "すべてのページを含む1つのPDF。ピクチャはセルのサイズで埋め込まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "모든 페이지가 담긴 하나의 PDF이며, 사진은 셀 크기로 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eén PDF met alle pagina’s; afbeeldingen worden ingesloten op de grootte van hun cellen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਹਰ ਪੰਨੇ ਵਾਲੀ ਇੱਕ PDF; ਤਸਵੀਰਾਂ ਉਹਨਾਂ ਦੇ ਸੈੱਲਾਂ ਦੇ ਆਕਾਰ ’ਤੇ ਸ਼ਾਮਲ ਕੀਤੀਆਂ ਜਾਂਦੀਆਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Jeden plik PDF ze wszystkimi stronami; obrazy są osadzane w rozmiarze komórek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Um PDF com todas as páginas; as imagens são incorporadas no tamanho das células."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "எல்லாப் பக்கங்களுடனும் ஒரு PDF; படங்கள் அவற்றின் கட்டங்களின் அளவில் உட்பொதிக்கப்படும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
