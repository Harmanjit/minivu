        }
      }
    },
    "The rating couldn’t be written into “%@”." : {
      "comment" : "Alert title; %@ is a file name",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Bewertung konnte nicht in „%@“ geschrieben werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se ha podido escribir la valoración en “%@”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible d’écrire la note dans « %@ »."
          }
        },
        "it" : {
          "stringUnit" : {
