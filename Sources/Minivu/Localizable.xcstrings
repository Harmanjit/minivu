    "Slideshows play full screen on the display chosen for the full-screen viewer in Viewer settings." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "স্লাইডশো ভিউয়ার সেটিংসে ফুল-স্ক্রিন ভিউয়ারের জন্য বেছে নেওয়া ডিসপ্লেতে ফুল স্ক্রিনে চলে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diashows werden im Vollbildmodus auf dem Display abgespielt, das in den Betrachter-Einstellungen für den Vollbild-Betrachter gewählt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los pases de diapositivas se reproducen a pantalla completa en la pantalla elegida para el visor a pantalla completa en los ajustes del visor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les diaporamas sont lus en plein écran sur l’écran choisi pour la visionneuse plein écran dans les réglages Visionneuse."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "સ્લાઇડશો વ્યૂઅર સેટિંગ્સમાં પૂર્ણ-સ્ક્રીન વ્યૂઅર માટે પસંદ કરેલા ડિસ્પ્લે પર પૂર્ણ સ્ક્રીનમાં ચાલે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्लाइडशो उस डिस्प्ले पर फ़ुल स्क्रीन में चलते हैं जो व्यूअर सेटिंग्ज़ में फ़ुल स्क्रीन व्यूअर के लिए चुना गया है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le presentazioni vengono riprodotte a tutto schermo sul monitor scelto per il visore a tutto schermo nelle impostazioni del visore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "スライドショーは、「ビューア」設定でフルスクリーンビューア用に選択したディスプレイでフルスクリーン再生されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "슬라이드쇼는 뷰어 설정에서 전체 화면 뷰어용으로 선택한 디스플레이에서 전체 화면으로 재생됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Diavoorstellingen worden schermvullend afgespeeld op het scherm dat in de Viewer-instellingen voor de schermvullende viewer is gekozen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਸਲਾਈਡਸ਼ੋ ਉਸ ਡਿਸਪਲੇ ’ਤੇ ਪੂਰੀ ਸਕ੍ਰੀਨ ਵਿੱਚ ਚੱਲਦੇ ਹਨ ਜੋ ਵਿਊਅਰ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਪੂਰੀ-ਸਕ੍ਰੀਨ ਵਿਊਅਰ ਲਈ ਚੁਣਿਆ ਗਿਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokazy slajdów są odtwarzane na pełnym ekranie na ekranie wybranym dla pełnoekranowego widoku obrazu w ustawieniach Widok obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As apresentações de slides são reproduzidas em tela cheia na tela escolhida para o visualizador em tela cheia nos ajustes do Visualizador."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "பார்வையி அமைப்புகளில் முழுத்திரைப் பார்வையிக்காகத் தேர்ந்தெடுத்த டிஸ்பிளேயில் ஸ்லைடுஷோக்கள் முழுத்திரையில் இயங்கும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "幻灯片会在“查看器”设置中为全屏幕查看器选取的显示器上全屏幕播放。"
          }
        }
      }
    },
