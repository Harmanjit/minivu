    "HDR photos keep their highlights, written with a gain map. Off, they are tone mapped to SDR." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "HDR-Fotos behalten ihre Lichter, mit einer Gain-Map geschrieben. Ist dies deaktiviert, werden sie per Tone-Mapping in SDR umgewandelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
