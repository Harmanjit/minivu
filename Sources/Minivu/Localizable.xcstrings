        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "XMP 사이드카에서 위치 정보가 제거되었지만, minivu가 절대 수정하지 않는 다음 카메라 RAW 파일에는 남아 있습니다:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
