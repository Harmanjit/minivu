    "%@. Fields that differ show as mixed; only fields you change are written." : {
      "comment" : "Metadata editor header; %@ is a number of images, such as “12 images”",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Abweichende Felder werden als gemischt angezeigt; nur Felder, die du änderst, werden geschrieben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Los campos que difieren se muestran como mixtos; solo se escriben los campos que cambies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Les champs qui diffèrent apparaissent comme mixtes ; seuls les champs que vous modifiez sont écrits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. I campi che differiscono sono indicati come misti; vengono scritti solo i campi che modifichi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@。値が異なるフィールドは混在として表示されます。書き込まれるのは変更したフィールドだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. 서로 다른 필드는 혼합으로 표시되며, 변경한 필드만 기록됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Velden die verschillen, worden als gemengd getoond; alleen velden die je wijzigt, worden geschreven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Pola, które się różnią, są oznaczone jako mieszane; zapisywane są tylko zmienione pola."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@. Os campos diferentes aparecem como mistos; só os campos que você alterar serão gravados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@。不同的字段显示为混合值；仅写入你更改的字段。"
          }
        }
      }
    },
