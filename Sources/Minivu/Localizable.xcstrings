    "Reload" : {
      "comment" : "Button: reloads the file from disk, discarding edits",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পুনরায় লোড করুন"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
