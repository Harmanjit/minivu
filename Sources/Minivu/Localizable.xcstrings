    "The longest side in pixels. Leave empty to keep the size; smaller images are never enlarged." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পিক্সেলে সবচেয়ে লম্বা দিক। আকার রাখতে খালি রাখুন; ছোট ছবি কখনো বড় করা হয় না।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die längste Seite in Pixeln. Leer lassen, um die Größe beizubehalten; kleinere Bilder werden nie vergrößert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El lado más largo en píxeles. Déjalo vacío para conservar el tamaño; las imágenes más pequeñas nunca se amplían."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le plus grand côté en pixels. Laissez vide pour conserver la taille ; les images plus petites ne sont jamais agrandies."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "પિક્સેલમાં સૌથી લાંબી બાજુ. કદ રાખવા માટે ખાલી છોડો; નાની ઇમેજ ક્યારેય મોટી કરવામાં આવતી નથી."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पिक्सेल में सबसे लंबी साइड। आकार न बदलने के लिए खाली छोड़ें; छोटी इमेज कभी बड़ी नहीं की जातीं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il lato più lungo in pixel. Lascia vuoto per mantenere le dimensioni; le immagini più piccole non vengono mai ingrandite."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "長辺のピクセル数。空のままにするとサイズを保持します。小さいイメージが拡大されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "긴 변의 픽셀 수입니다. 크기를 유지하려면 비워 두십시오. 작은 이미지는 절대 확대되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "De langste zijde in pixels. Laat leeg om de grootte te behouden; kleinere afbeeldingen worden nooit vergroot."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਪਿਕਸਲਾਂ ਵਿੱਚ ਸਭ ਤੋਂ ਲੰਬਾ ਪਾਸਾ। ਆਕਾਰ ਰੱਖਣ ਲਈ ਖਾਲੀ ਛੱਡੋ; ਛੋਟੇ ਚਿੱਤਰ ਕਦੇ ਵੱਡੇ ਨਹੀਂ ਕੀਤੇ ਜਾਂਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dłuższy bok w pikselach. Pozostaw puste, aby zachować rozmiar; mniejsze obrazy nigdy nie są powiększane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O lado maior em pixels. Deixe vazio para manter o tamanho; imagens menores nunca são ampliadas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "பிக்சல்களில் நீண்ட பக்கம். அளவை வைத்திருக்கக் காலியாக விடுங்கள்; சிறிய படங்கள் ஒருபோதும் பெரிதாக்கப்படாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最长边的像素数。留空以保持尺寸；较小的图像永远不会被放大。"
          }
        }
      }
    },
    "The metadata of %lld files was updated." : {
      "comment" : "Alert title after editing metadata",
      "localizations" : {
        "bn" : {
          "variations" : {
            "plural" : {
              "one" : {
