        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 不是要转换的图像之一，但转换后的文件会占用它的名称。"
          }
        }
      }
    },
    "%@ opens the file as it was last saved, without the edits made here." : {
      "comment" : "%@ is an application's name",
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ফাইলটি সর্বশেষ সেভ করা অবস্থায় খোলে, এখানে করা সম্পাদনা ছাড়াই।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ öffnet die Datei im zuletzt gesicherten Zustand, ohne die hier vorgenommenen Änderungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ abre el archivo tal como se guardó por última vez, sin las ediciones hechas aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ouvre le fichier tel qu’il a été enregistré pour la dernière fois, sans les modifications effectuées ici."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ફાઇલને છેલ્લે સાચવી હતી તે રીતે ખોલે છે, અહીં કરેલાં સંપાદનો વિના."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ फ़ाइल को वैसे ही खोलता है जैसे वह पिछली बार सहेजी गई थी, यहाँ किए गए संपादनों के बिना।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ apre il file come è stato salvato l’ultima volta, senza le modifiche apportate qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@では、ここで行った編集を含まない、最後に保存された状態のファイルが開かれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에서는 여기서 한 편집 내용 없이 마지막으로 저장된 상태의 파일이 열립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ opent het bestand zoals het het laatst is bewaard, zonder de bewerkingen die hier zijn gemaakt."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ਫ਼ਾਈਲ ਨੂੰ ਉਸੇ ਤਰ੍ਹਾਂ ਖੋਲ੍ਹਦਾ ਹੈ ਜਿਵੇਂ ਇਹ ਆਖਰੀ ਵਾਰ ਸੰਭਾਲੀ ਗਈ ਸੀ, ਇੱਥੇ ਕੀਤੀਆਂ ਸੋਧਾਂ ਤੋਂ ਬਿਨਾਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ otworzy plik w ostatnio zachowanej wersji, bez wprowadzonych tutaj zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ abre o arquivo como foi salvo pela última vez, sem as edições feitas aqui."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ஃபைலைக் கடைசியாகச் சேமித்த நிலையில், இங்கே செய்த திருத்தங்கள் இல்லாமல் திறக்கும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ 会打开上次存储的文件，不包括在此处所做的编辑。"
          }
        }
      }
    },
