    "This file can’t be rewritten (camera raw, or a format ImageIO can’t rewrite), so the metadata goes in an XMP sidecar beside it." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই ফাইলটি পুনরায় লেখা যায় না (ক্যামেরা RAW, বা এমন ফরম্যাট যা ImageIO পুনরায় লিখতে পারে না), তাই মেটাডেটা এর পাশে একটি XMP সাইডকারে যায়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
