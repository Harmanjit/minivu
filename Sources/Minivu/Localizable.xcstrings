    "Turn on minivu in System Settings > Privacy & Security > Screen & System Audio Recording, then quit and reopen minivu." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aktiviere minivu in „Systemeinstellungen“ > „Datenschutz & Sicherheit“ > „Bildschirm- & Systemaudioaufnahme“, beende minivu und öffne es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activa minivu en Ajustes del Sistema > Privacidad y seguridad > Grabación de pantalla y audio del sistema, y luego sal de minivu y vuelve a abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Activez minivu dans Réglages Système > Confidentialité et sécurité > Enregistrement de l’écran et de l’audio du système, puis quittez et rouvrez minivu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Attiva minivu in Impostazioni di Sistema > Privacy e sicurezza > Registrazione schermo e audio di sistema, quindi esci e riapri minivu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「システム設定」>「プライバシーとセキュリティ」>「画面収録とシステムオーディオ録音」でminivuをオンにしてから、minivuを終了して開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "시스템 설정 > 개인정보 보호 및 보안 > 화면 및 시스템 오디오 녹음에서 minivu를 켠 다음 minivu를 종료했다가 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Schakel minivu in bij Systeeminstellingen > Privacy en beveiliging > Scherm- en systeemaudio-opname en stop en open minivu daarna opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Włącz minivu w Ustawienia systemowe > Prywatność i ochrona > Nagrywanie ekranu i dźwięku systemowego, a następnie zakończ i ponownie otwórz minivu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ative o minivu em Ajustes do Sistema > Privacidade e Segurança > Gravação de Tela e Áudio do Sistema e, depois, encerre e reabra o minivu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请在“系统设置”>“隐私与安全性”>“录屏与系统录音”中打开 minivu，然后退出并重新打开 minivu。"
          }
        }
      }
    },
