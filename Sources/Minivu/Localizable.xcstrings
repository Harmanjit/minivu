    "Spacing and margin must be between 0 and 1,000 pixels." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abstand und Rand müssen zwischen 0 und 1.000 Pixeln liegen."
          }
        },
        "es" : {
