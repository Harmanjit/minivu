            "value" : "Ricarica"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "再読み込み"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다시 불러오기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Laad opnieuw"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਮੁੜ ਲੋਡ ਕਰੋ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wczytaj ponownie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recarregar"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "மீண்டும் ஏற்று"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "重新载入"
          }
        }
      }
    },
    "Reload shows the version saved there and discards your edits. If you keep your edits, saving them asks for a name, so the other version isn’t replaced." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পুনরায় লোড করলে সেখানে সেভ করা সংস্করণটি দেখায় এবং আপনার সম্পাদনা বাতিল হয়। আপনি সম্পাদনা রাখলে, সেভ করার সময় একটি নাম চাওয়া হয়, যাতে অন্য সংস্করণটি প্রতিস্থাপিত না হয়।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Neu laden“ zeigt die dort gesicherte Version und verwirft deine Änderungen. Wenn du deine Änderungen behältst, wirst du beim Sichern nach einem Namen gefragt, damit die andere Version nicht ersetzt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Volver a cargar muestra la versión guardada allí y descarta tus ediciones. Si conservas tus ediciones, al guardarlas se te pedirá un nombre para no reemplazar la otra versión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recharger affiche la version enregistrée sur le disque et supprime vos modifications. Si vous conservez vos modifications, leur enregistrement vous demandera un nom, afin de ne pas remplacer l’autre version."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ફરી લોડ કરો ત્યાં સાચવેલું વર્ઝન બતાવે છે અને તમારાં સંપાદનો કાઢી નાખે છે. જો તમે તમારાં સંપાદનો રાખો, તો તેમને સાચવતી વખતે નામ પૂછવામાં આવે છે, જેથી બીજું વર્ઝન બદલાય નહીં."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "रीलोड करने पर वहाँ सहेजा गया संस्करण दिखता है और आपके संपादन खो जाते हैं। अगर आप अपने संपादन रखते हैं, तो उन्हें सहेजते समय नाम पूछा जाता है, ताकि दूसरा संस्करण न बदले।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ricarica mostra la versione salvata lì ed elimina le tue modifiche. Se mantieni le modifiche, per salvarle ti verrà chiesto un nome, così l’altra versione non verrà sostituita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「再読み込み」を選ぶと、そこに保存されているバージョンが表示され、編集内容は破棄されます。編集内容を残す場合は、保存時に名前を指定するので、もう一方のバージョンは置き換えられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "다시 불러오면 그곳에 저장된 버전이 표시되고 편집 내용은 폐기됩니다. 편집 내용을 유지하면 저장할 때 이름을 묻게 되므로 다른 버전은 대치되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Opnieuw laden toont de versie die daar is bewaard en verwijdert je bewerkingen. Als je je bewerkingen behoudt, wordt bij het bewaren om een naam gevraagd, zodat de andere versie niet wordt vervangen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਮੁੜ ਲੋਡ ਕਰੋ ਉੱਥੇ ਸੰਭਾਲਿਆ ਸੰਸਕਰਣ ਦਿਖਾਉਂਦਾ ਹੈ ਅਤੇ ਤੁਹਾਡੀਆਂ ਸੋਧਾਂ ਰੱਦ ਕਰ ਦਿੰਦਾ ਹੈ। ਜੇ ਤੁਸੀਂ ਆਪਣੀਆਂ ਸੋਧਾਂ ਰੱਖਦੇ ਹੋ, ਤਾਂ ਉਹਨਾਂ ਨੂੰ ਸੰਭਾਲਣ ਵੇਲੇ ਨਾਮ ਪੁੱਛਿਆ ਜਾਂਦਾ ਹੈ, ਤਾਂ ਜੋ ਦੂਜੇ ਸੰਸਕਰਣ ਦੀ ਥਾਂ ਕੋਈ ਹੋਰ ਫ਼ਾਈਲ ਨਾ ਰੱਖੀ ਜਾਵੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wczytanie ponowne pokaże zachowaną tam wersję i odrzuci Twoje zmiany. Jeśli zachowasz swoje zmiany, przy zachowywaniu pojawi się pytanie o nazwę, więc druga wersja nie zostanie zastąpiona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Recarregar mostra a versão salva lá e descarta suas edições. Se você mantiver suas edições, será pedido um nome ao salvá-las, para que a outra versão não seja substituída."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "மீண்டும் ஏற்றுதல் அங்கே சேமிக்கப்பட்ட பதிப்பைக் காட்டி உங்கள் திருத்தங்களை நிராகரிக்கும். உங்கள் திருத்தங்களை வைத்திருந்தால், அவற்றைச் சேமிக்கும்போது ஒரு பெயர் கேட்கப்படும், எனவே மற்ற பதிப்பின் மேல் அவை சேமிக்கப்படாது."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“重新载入”会显示存储在那里的版本并放弃你的编辑。如果保留编辑，存储时会要求输入名称，因此不会替换另一个版本。"
          }
        }
      }
    },
