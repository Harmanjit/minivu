    "Boost is how much of the RAW engine’s contrast curve is applied; lower is flatter." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "বুস্ট হলো RAW ইঞ্জিনের কনট্রাস্ট কার্ভের কতটা প্রয়োগ করা হয়; কম মানে আরও সমতল।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Verstärkung gibt an, wie viel von der Kontrastkurve der RAW-Engine angewendet wird; niedriger ist flacher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Refuerzo indica cuánto se aplica de la curva de contraste del motor RAW; un valor menor es más plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le renforcement indique quelle part de la courbe de contraste du moteur RAW est appliquée ; plus la valeur est basse, plus l’image est plate."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "બૂસ્ટ એટલે RAW એન્જિનના કૉન્ટ્રાસ્ટ કર્વનો કેટલો ભાગ લાગુ થાય છે; ઓછું એટલે વધુ સપાટ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बूस्ट यह तय करता है कि RAW इंजन के कंट्रास्ट कर्व का कितना हिस्सा लागू हो; कम मान अधिक सपाट होता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Potenziamento indica quanta parte della curva di contrasto del motore RAW viene applicata; un valore più basso produce un’immagine più piatta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「ブースト」はRAWエンジンのコントラストカーブの適用量です。値が小さいほどフラットになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "부스트는 RAW 엔진의 대비 곡선이 적용되는 정도이며, 낮을수록 더 평평해집니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Versterking bepaalt hoeveel van de contrastcurve van de RAW-engine wordt toegepast; lager is vlakker."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਬੂਸਟ ਦੱਸਦਾ ਹੈ ਕਿ RAW ਇੰਜਣ ਦਾ ਕੰਟ੍ਰਾਸਟ ਕਰਵ ਕਿੰਨਾ ਲਾਗੂ ਹੁੰਦਾ ਹੈ; ਘੱਟ ਮੁੱਲ ਵਧੇਰੇ ਸਪਾਟ ਹੁੰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wzmocnienie określa, jaka część krzywej kontrastu silnika RAW zostanie zastosowana; mniejsza wartość daje bardziej płaski obraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Reforço é a parte da curva de contraste do mecanismo RAW que é aplicada; menos é mais plano."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "பூஸ்ட் என்பது RAW எஞ்சினின் கான்ட்ராஸ்ட் வளைவில் எவ்வளவு பயன்படுத்தப்படுகிறது என்பது; குறைவாக இருந்தால் தட்டையாக இருக்கும்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“增强”表示应用 RAW 引擎对比度曲线的程度；值越低越平淡。"
          }
        }
      }
    },
