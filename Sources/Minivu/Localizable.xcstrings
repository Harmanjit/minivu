    "Stopped before the end: only the images compared so far are grouped." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "শেষের আগেই থামানো হয়েছে: শুধু এ পর্যন্ত তুলনা করা ছবিগুলো গ্রুপ করা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vor dem Ende gestoppt: Nur die bisher verglichenen Bilder sind gruppiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Se ha detenido antes del final: solo se agrupan las imágenes comparadas hasta ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Arrêt avant la fin : seules les images comparées jusqu’ici sont regroupées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "અંત પહેલાં રોકાયું: અત્યાર સુધી સરખાવેલી ઇમેજ જ ગ્રુપમાં મુકાઈ છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अंत से पहले रोका गया: केवल अब तक तुलना की गई इमेज समूहों में रखी गई हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interrotto prima della fine: vengono raggruppate solo le immagini confrontate finora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "最後まで終わる前に停止しました：それまでに比較したイメージだけがグループ化されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "끝나기 전에 중단됨: 지금까지 비교한 이미지만 그룹으로 묶였습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gestopt vóór het einde: alleen de tot nu toe vergeleken afbeeldingen zijn gegroepeerd."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਅੰਤ ਤੋਂ ਪਹਿਲਾਂ ਰੁਕ ਗਿਆ: ਸਿਰਫ਼ ਹੁਣ ਤੱਕ ਤੁਲਨਾ ਕੀਤੇ ਚਿੱਤਰਾਂ ਨੂੰ ਸਮੂਹਬੱਧ ਕੀਤਾ ਗਿਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zatrzymano przed końcem: pogrupowano tylko dotychczas porównane obrazy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Interrompido antes do fim: somente as imagens comparadas até agora foram agrupadas."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "முடிவுக்கு முன் நிறுத்தப்பட்டது: இதுவரை ஒப்பிட்ட படங்கள் மட்டுமே குழுவாக்கப்பட்டன."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在完成前已停止：仅对目前已比较的图像进行分组。"
          }
        }
      }
    },
