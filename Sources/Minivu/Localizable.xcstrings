    "It may have been moved or deleted. Add it again in Settings > Editors." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটি সরানো বা মুছে ফেলা হয়ে থাকতে পারে। সেটিংস > এডিটর-এ এটি আবার যোগ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Programm wurde möglicherweise bewegt oder gelöscht. Füge es in „Einstellungen“ > „Editoren“ erneut hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
