    "Auto looks for the most prominent rectangle: a document, a screen, a window or a building’s face." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অটো সবচেয়ে প্রধান আয়তক্ষেত্রটি খোঁজে: একটি নথি, একটি স্ক্রিন, একটি উইন্ডো বা একটি ভবনের সামনের দিক।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„Automatisch“ sucht nach dem auffälligsten Rechteck: einem Dokument, einem Bildschirm, einem Fenster oder einer Gebäudefassade."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto busca el rectángulo más destacado: un documento, una pantalla, una ventana o la fachada de un edificio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto recherche le rectangle le plus marquant : un document, un écran, une fenêtre ou une façade."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ઑટો સૌથી સ્પષ્ટ લંબચોરસ શોધે છે: દસ્તાવેજ, સ્ક્રીન, વિન્ડો અથવા ઇમારતનો આગળનો ભાગ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "स्वतः सबसे प्रमुख आयत ढूँढता है: कोई दस्तावेज़, स्क्रीन, विंडो या इमारत का सामने का हिस्सा।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatico cerca il rettangolo più evidente: un documento, uno schermo, una finestra o la facciata di un edificio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "「自動」では、最も目立つ長方形（書類、画面、窓、建物の正面など）を探します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "자동은 가장 눈에 띄는 직사각형(문서, 화면, 윈도우 또는 건물 정면)을 찾습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Automatisch zoekt naar de meest opvallende rechthoek: een document, een scherm, een raam of de gevel van een gebouw."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਆਟੋ ਸਭ ਤੋਂ ਪ੍ਰਮੁੱਖ ਆਇਤ ਲੱਭਦਾ ਹੈ: ਕੋਈ ਦਸਤਾਵੇਜ਼, ਸਕ੍ਰੀਨ, ਵਿੰਡੋ ਜਾਂ ਇਮਾਰਤ ਦਾ ਅਗਲਾ ਹਿੱਸਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auto szuka najbardziej wyraźnego prostokąta: dokumentu, ekranu, okna lub fasady budynku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Automático procura o retângulo mais evidente: um documento, uma tela, uma janela ou a fachada de um prédio."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "தானியங்கு மிகத் தெளிவான செவ்வகத்தைத் தேடும்: ஒரு ஆவணம், ஒரு திரை, ஒரு சாளரம் அல்லது ஒரு கட்டடத்தின் முகப்பு."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“自动”会查找最显著的矩形：文稿、屏幕、窗口或建筑物的正面。"
          }
        }
      }
    },
