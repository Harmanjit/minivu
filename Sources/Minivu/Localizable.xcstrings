        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non è tra le immagini da convertire, ma un file convertito ne prenderebbe il nome."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@は変換対象のイメージではありませんが、変換後のファイルがこの名前になってしまいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@은(는) 변환 중인 이미지가 아니지만, 변환된 파일이 그 이름을 갖게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ hoort niet bij de afbeeldingen die worden geconverteerd, maar een geconverteerd bestand zou de naam ervan krijgen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ਕਨਵਰਟ ਕੀਤੇ ਜਾ ਰਹੇ ਚਿੱਤਰਾਂ ਵਿੱਚੋਂ ਇੱਕ ਨਹੀਂ ਹੈ, ਪਰ ਕਨਵਰਟ ਕੀਤੀ ਫ਼ਾਈਲ ਇਸਦਾ ਨਾਮ ਲੈ ਲਵੇਗੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ nie należy do konwertowanych obrazów, ale przekonwertowany plik przyjąłby jego nazwę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ não é uma das imagens a converter, mas um arquivo convertido receberia esse nome."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ மாற்றப்படும் படங்களில் ஒன்றல்ல, ஆனால் மாற்றப்பட்ட ஒரு ஃபைல் அதன் பெயரை எடுத்துக்கொள்ளும்."
          }
