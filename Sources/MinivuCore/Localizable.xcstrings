    "%@ contains no image minivu can decode." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@-এ এমন কোনো ছবি নেই যা minivu ডিকোড করতে পারে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ enthält kein Bild, das minivu decodieren kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ no contiene ninguna imagen que minivu pueda descodificar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ne contient aucune image que minivu peut décoder."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@માં એવી કોઈ ઇમેજ નથી જે minivu ડીકોડ કરી શકે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ में ऐसी कोई इमेज नहीं है जिसे minivu डिकोड कर सके।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non contiene immagini che minivu possa decodificare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@にはminivuでデコードできるイメージがありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@에는 minivu가 디코딩할 수 있는 이미지가 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ bevat geen afbeelding die minivu kan decoderen."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ਵਿੱਚ ਅਜਿਹਾ ਕੋਈ ਚਿੱਤਰ ਨਹੀਂ ਹੈ ਜਿਸਨੂੰ minivu ਡੀਕੋਡ ਕਰ ਸਕੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ nie zawiera obrazu, który minivu potrafi zdekodować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ não contém nenhuma imagem que o minivu consiga decodificar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu டிகோட் செய்யக்கூடிய படம் எதுவும் %@-இல் இல்லை."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@”中没有 minivu 可以解码的图像。"
