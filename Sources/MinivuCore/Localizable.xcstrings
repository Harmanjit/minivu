    "Names that begin with a dot “.” are reserved for the system." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডট “.” দিয়ে শুরু হওয়া নাম সিস্টেমের জন্য সংরক্ষিত।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Namen, die mit einem Punkt „.“ beginnen, sind für das System reserviert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los nombres que empiezan por un punto “.” están reservados para el sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les noms commençant par un point « . » sont réservés au système."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ડૉટ “.” થી શરૂ થતાં નામ સિસ્ટમ માટે અનામત છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "बिंदु “.” से शुरू होने वाले नाम सिस्टम के लिए आरक्षित हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I nomi che iniziano con un punto “.” sono riservati al sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドット“.”で始まる名前はシステム用に予約されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "마침표(.)로 시작하는 이름은 시스템용으로 예약되어 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Namen die met een punt ‘.’ beginnen, zijn voorbehouden aan het systeem."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਬਿੰਦੂ “.” ਨਾਲ ਸ਼ੁਰੂ ਹੋਣ ਵਾਲੇ ਨਾਮ ਸਿਸਟਮ ਲਈ ਰਾਖਵੇਂ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nazwy zaczynające się od kropki „.” są zarezerwowane dla systemu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nomes que começam com um ponto “.” são reservados para o sistema."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "புள்ளியில் “.” தொடங்கும் பெயர்கள் சிஸ்டத்துக்கு ஒதுக்கப்பட்டவை."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "以点“.”开头的名称为系统保留。"
          }
        }
      }
    },
    "No" : {
