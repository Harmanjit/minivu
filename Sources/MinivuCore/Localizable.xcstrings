    "minivu works only with folders on this Mac’s internal storage." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu শুধুমাত্র এই Mac-এর অভ্যন্তরীণ স্টোরেজের ফোল্ডারগুলোর সাথে কাজ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu funktioniert nur mit Ordnern auf dem internen Speicher dieses Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu solo funciona con carpetas del almacenamiento interno de este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu ne fonctionne qu’avec les dossiers du stockage interne de ce Mac."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu ફક્ત આ Macના આંતરિક સ્ટોરેજ પરના ફોલ્ડર સાથે જ કામ કરે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu केवल इस Mac के आंतरिक स्टोरेज के फ़ोल्डर के साथ काम करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "minivu funziona solo con le cartelle nell’archiviazione interna di questo Mac."
          }
        },
