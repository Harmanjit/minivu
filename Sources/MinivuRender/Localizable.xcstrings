    "“%@” changed on disk after editing began, so the edits can’t be applied to it again. Reopen the image to keep editing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%@“ wurde nach Beginn der Bearbeitung auf der Festplatte geändert, daher können die Änderungen nicht erneut darauf angewendet werden. Öffne das Bild erneut, um weiter zu bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” ha cambiado en el disco desde que empezó la edición, así que no se pueden volver a aplicar las ediciones. Vuelve a abrir la imagen para seguir editando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "« %@ » a été modifié sur le disque après le début des modifications ; elles ne peuvent donc plus lui être appliquées. Rouvrez l’image pour continuer à la modifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” è stato modificato sul disco dopo l’inizio delle modifiche, quindi non è possibile applicarle di nuovo. Riapri l’immagine per continuare a modificarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "編集の開始後に“%@”がディスク上で変更されたため、編集内容をもう一度適用できません。編集を続けるにはイメージを開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "편집을 시작한 후 디스크의 “%@”이(가) 변경되어 편집 내용을 다시 적용할 수 없습니다. 계속 편집하려면 이미지를 다시 여십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "‘%@’ is op schijf gewijzigd nadat het bewerken begon, dus de bewerkingen kunnen er niet opnieuw op worden toegepast. Open de afbeelding opnieuw om verder te bewerken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Plik „%@” zmienił się na dysku po rozpoczęciu edycji, więc nie można ponownie zastosować do niego zmian. Otwórz obraz ponownie, aby kontynuować edycję."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%@” foi alterado no disco depois do início da edição, por isso as edições não podem ser aplicadas a ele novamente. Reabra a imagem para continuar editando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "开始编辑后“%@”在磁盘上发生了更改，因此无法再次对其应用编辑。请重新打开图像以继续编辑。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}