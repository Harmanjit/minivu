    "Brush strokes are painted on this photo’s content." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ব্রাশ স্ট্রোকগুলো এই ফটোর বিষয়বস্তুর উপর আঁকা হয়েছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pinselstriche werden auf den Inhalt dieses Fotos gemalt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Las pinceladas se pintan sobre el contenido de esta foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les coups de pinceau sont peints sur le contenu de cette photo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "બ્રશ સ્ટ્રોક આ ફોટોની સામગ્રી પર દોરવામાં આવ્યા છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ब्रश स्ट्रोक इस फ़ोटो की सामग्री पर पेंट किए गए हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le pennellate sono dipinte sul contenuto di questa foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ブラシのストロークはこの写真の内容に合わせて描かれています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 사진의 내용 위에 브러시 획이 칠해져 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Penseelstreken zijn op de inhoud van deze foto geschilderd."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਬੁਰਸ਼ ਸਟ੍ਰੋਕ ਇਸ ਫ਼ੋਟੋ ਦੀ ਸਮੱਗਰੀ ਉੱਤੇ ਪੇਂਟ ਕੀਤੇ ਗਏ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pociągnięcia pędzla są malowane na treści tego zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "As pinceladas são pintadas sobre o conteúdo desta foto."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "தூரிகைக் கோடுகள் இந்தப் புகைப்படத்தின் உள்ளடக்கத்தின் மீது வரையப்படுகின்றன."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "画笔笔触绘制在这张照片的内容上。"
          }
        }
      }
    },
