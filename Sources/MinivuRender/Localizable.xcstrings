    "It is a size in pixels for this photo. Use Batch Convert’s Resize, which works from each photo’s own size." : {
      "localizations" : {
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটি এই ফটোর জন্য পিক্সেলে একটি আকার। ব্যাচ রূপান্তরের আকার পরিবর্তন ব্যবহার করুন, যা প্রতিটি ফটোর নিজস্ব আকার থেকে কাজ করে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es ist eine Größe in Pixeln für dieses Foto. Verwende „Größe ändern“ in der Stapelkonvertierung, das von der Größe jedes einzelnen Fotos ausgeht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es un tamaño en píxeles para esta foto. Usa la opción Redimensionar de Conversión por lotes, que parte del tamaño de cada foto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Il s’agit d’une taille en pixels propre à cette photo. Utilisez Redimensionner dans Convertir par lot, qui part de la taille de chaque photo."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "તે આ ફોટો માટેનું પિક્સેલમાં કદ છે. બૅચ કન્વર્ટનું કદ બદલો વાપરો, જે દરેક ફોટોના પોતાના કદ પરથી કામ કરે છે."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह इस फ़ोटो के लिए पिक्सेल में एक आकार है। बैच कन्वर्ट का “आकार बदलें” इस्तेमाल करें, जो हर फ़ोटो के अपने आकार से काम करता है।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "È una dimensione in pixel per questa foto. Usa Ridimensiona di Converti in blocco, che lavora sulle dimensioni di ogni foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "これはこの写真のピクセル単位のサイズです。各写真自身のサイズを基準にする「一括変換」の「サイズを変更」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 사진에 대한 픽셀 크기입니다. 각 사진의 원래 크기를 기준으로 작동하는 일괄 변환의 크기 조절을 사용하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Het is een grootte in pixels voor deze foto. Gebruik het formaat wijzigen van Batchconversie, dat uitgaat van de eigen grootte van elke foto."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ਇਹ ਇਸ ਫ਼ੋਟੋ ਲਈ ਪਿਕਸਲਾਂ ਵਿੱਚ ਇੱਕ ਆਕਾਰ ਹੈ। ਬੈਚ ਕਨਵਰਟ ਦਾ ਆਕਾਰ ਬਦਲੋ ਵਰਤੋ, ਜੋ ਹਰ ਫ਼ੋਟੋ ਦੇ ਆਪਣੇ ਆਕਾਰ ਤੋਂ ਕੰਮ ਕਰਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To rozmiar w pikselach dla tego zdjęcia. Użyj zmiany rozmiaru w konwersji wsadowej, która liczy od rozmiaru każdego zdjęcia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "É um tamanho em pixels para esta foto. Use o Redimensionar da Conversão em Lote, que parte do tamanho de cada foto."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "இது இந்தப் புகைப்படத்துக்கான பிக்சல் அளவு. ஒவ்வொரு புகைப்படத்தின் சொந்த அளவிலிருந்து செயல்படும் மொத்தமாக மாற்றுதலின் “அளவை மாற்று” என்பதைப் பயன்படுத்துங்கள்."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这是针对这张照片的像素尺寸。请使用“批量转换”中的“调整大小”，它以每张照片自身的尺寸为基准。"
          }
        }
      }
    },
